{
  "version": 1,
  "workflow": {
    "mode": "efficient",
    "unitTestsAfterPr": false,
    "publication": "draft",
    "optionalBuilds": false
  },
  "name": "Example React and .NET repository",
  "architecture": "React frontend with ASP.NET Core backend",
  "components": [
    {
      "name": "frontend",
      "paths": [
        "frontend/src"
      ],
      "testPatterns": [
        "frontend/src/**/*.test.ts",
        "frontend/src/**/*.test.tsx"
      ]
    },
    {
      "name": "backend",
      "paths": [
        "backend/src"
      ],
      "testPatterns": [
        "backend/tests/**/*.cs"
      ]
    }
  ],
  "validation": {
    "gates": [
      {
        "id": "frontend-tests",
        "command": "npm",
        "args": ["test", "--", "--runInBand", "--watchAll=false"],
        "workingDirectory": "frontend",
        "timeoutSeconds": 300
      },
      {
        "id": "frontend-typecheck",
        "command": "npm",
        "args": ["run", "type-check"],
        "workingDirectory": "frontend",
        "reuse": true,
        "timeoutSeconds": 300
      },
      {
        "id": "backend-tests",
        "command": "dotnet",
        "args": ["test"],
        "workingDirectory": "backend",
        "timeoutSeconds": 600
      }
    ],
    "commands": {
      "frontendRestore": "npm ci",
      "frontendTest": "npm test -- --runInBand",
      "frontendTypeCheck": "npm run type-check",
      "frontendBuild": "npm run build",
      "backendRestore": "dotnet restore",
      "backendTest": "dotnet test",
      "backendBuild": "dotnet build"
    },
    "productionBuildTimeoutMinutes": 15,
    "agentIdleTimeoutMinutes": 20,
    "blockerPolicy": "continue-on-owned-process-timeout"
  },
  "applications": {
    "frontend": {
      "workingDirectory": "frontend",
      "command": "npm start",
      "port": 3000,
      "healthUrl": "http://localhost:3000"
    },
    "backend": {
      "workingDirectory": "backend/src",
      "command": "dotnet run",
      "port": 5000,
      "healthUrl": "http://localhost:5000/health"
    }
  },
  "browserAutomation": {
    "workingDirectory": "frontend",
    "package": "@playwright/test",
    "browser": "chromium",
    "testCommand": "npm run test:e2e",
    "testSynthesis": {
      "enabled": true,
      "defaultDataSource": "synthetic-intercepted",
      "mutationMode": "intercepted",
      "requireScenarioEvidence": true
    },
    "authentication": {
      "required": false,
      "command": "",
      "environment": {},
      "statusPaths": []
    },
    "dataSafety": {
      "policy": "Use local mock data or intercept every mutating request; require explicit approval before using non-production records.",
      "productionAllowed": false
    }
  },
  "environments": [
    "local",
    "development",
    "integration"
  ],
  "pullRequests": {
    "defaultTargetBranch": "develop",
    "requireConfirmation": true,
    "branchNaming": {
      "userId": "your-user-id",
      "prefixTemplate": "users/{userId}"
    }
  }
}
