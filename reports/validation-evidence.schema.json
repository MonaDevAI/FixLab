{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MonaDevAI/FixLab/reports/validation-evidence.schema.json",
  "title": "FixLab validation evidence",
  "type": "object",
  "required": [
    "workflowRunId",
    "workflowName",
    "commit",
    "conclusion"
  ],
  "properties": {
    "workflowRunId": {
      "type": "integer"
    },
    "workflowName": {
      "type": "string"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "conclusion": {
      "enum": [
        "success",
        "failure",
        "cancelled",
        "timed_out",
        "action_required",
        "neutral",
        "skipped",
        "stale"
      ]
    }
  },
  "additionalProperties": true
}
